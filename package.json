{
    "name": "belgica",
    "version": "0.6.2",
    "description": "Belgian legal reference data: courts, judicial cantons and arrondissements, municipalities and postal codes, legal and commercial interest rates, and the public and judicial holidays.",
    "keywords": [
        "belgium",
        "belgian",
        "legal",
        "courts",
        "judicial-cantons",
        "arrondissements",
        "municipalities",
        "refnis",
        "postal-codes",
        "geojson",
        "interest-rates",
        "public-holidays",
        "deadlines",
        "vredegerecht",
        "justice-of-the-peace"
    ],
    "license": "MIT AND CC-BY-4.0",
    "author": "Pieter-Jan Scheir",
    "homepage": "https://pieterjanscheir.github.io/belgica/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pieterjanscheir/belgica.git"
    },
    "bugs": {
        "url": "https://github.com/pieterjanscheir/belgica/issues"
    },
    "type": "module",
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": ">=22.12"
    },
    "sideEffects": false,
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./territory": {
            "types": "./dist/territory.d.ts",
            "default": "./dist/territory.js"
        },
        "./cantons": {
            "types": "./dist/cantons.d.ts",
            "default": "./dist/cantons.js"
        },
        "./cantons/territory": {
            "types": "./dist/canton-territory.d.ts",
            "default": "./dist/canton-territory.js"
        },
        "./canton-boundaries": {
            "types": "./dist/canton-boundaries.d.ts",
            "default": "./dist/canton-boundaries.js"
        },
        "./arrondissement-boundaries": {
            "types": "./dist/arrondissement-boundaries.d.ts",
            "default": "./dist/arrondissement-boundaries.js"
        },
        "./courts": {
            "types": "./dist/courts.d.ts",
            "default": "./dist/courts.js"
        },
        "./court-locations": {
            "types": "./dist/court-locations.d.ts",
            "default": "./dist/court-locations.js"
        },
        "./courts/format": {
            "types": "./dist/courts-format.d.ts",
            "default": "./dist/courts-format.js"
        },
        "./courts/load": {
            "types": "./dist/courts-load.d.ts",
            "default": "./dist/courts-load.js"
        },
        "./prisons": {
            "types": "./dist/prisons.d.ts",
            "default": "./dist/prisons.js"
        },
        "./houses-of-justice": {
            "types": "./dist/houses-of-justice.d.ts",
            "default": "./dist/houses-of-justice.js"
        },
        "./interest-rates": {
            "types": "./dist/interest-rates.d.ts",
            "default": "./dist/interest-rates.js"
        },
        "./calendar": {
            "types": "./dist/calendar.d.ts",
            "default": "./dist/calendar.js"
        },
        "./postal-codes": {
            "types": "./dist/postal-codes.d.ts",
            "default": "./dist/postal-codes.js"
        },
        "./police-zones": {
            "types": "./dist/police-zones.d.ts",
            "default": "./dist/police-zones.js"
        },
        "./schemas": {
            "types": "./dist/schemas.d.ts",
            "default": "./dist/schemas.js"
        },
        "./data/*": "./data/*",
        "./schema/*": "./schema/*",
        "./datapackage.json": "./datapackage.json",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "data",
        "schema",
        "datapackage.json",
        "LICENSE-DATA"
    ],
    "scripts": {
        "build": "pnpm build:data-files && tsup",
        "build:cantons": "node scripts/build-cantons.ts",
        "build:data": "node scripts/parse/build.ts",
        "build:csv": "node scripts/build-csv.ts",
        "build:cases": "node scripts/build-cases.ts",
        "fetch:sources": "node scripts/sources/fetch.ts",
        "test": "pnpm build:data-files && vitest run",
        "typecheck": "pnpm build:data-files && tsc --noEmit",
        "check": "pnpm generate && pnpm typecheck && pnpm lint && pnpm build && pnpm test:coverage && pnpm test:package && pnpm lint:package && git diff --exit-code -- schema data/courts.json src/ids.generated.ts src/canton-names.generated.ts src/data-files.generated.ts src/court-details-files.generated.ts ids.lock.json",
        "prepublishOnly": "pnpm check",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "site:dev": "pnpm --filter belgica-site dev",
        "site:build": "pnpm --filter belgica-site build",
        "build:schemas": "node scripts/build-schemas.ts",
        "test:freshness": "vitest run --config vitest.freshness.config.ts",
        "lint:package": "publint --strict && attw --pack . --profile esm-only",
        "build:ids": "node scripts/build-ids.ts",
        "lock:ids": "node scripts/lock-ids.ts",
        "generate": "pnpm build:court-labels && pnpm build:ids && pnpm build:canton-names && pnpm build:schemas && pnpm lock:ids && pnpm build:data-files",
        "lint": "eslint . && prettier --check .",
        "format": "prettier --write .",
        "test:coverage": "pnpm build:data-files && vitest run --coverage",
        "test:package": "node test/smoke/esm.mjs && node test/smoke/cjs.cjs && node test/smoke/courts-bundle.mjs && node test/smoke/bundle-size.mjs && node test/smoke/package-size.mjs",
        "build:canton-names": "node scripts/build-canton-names.ts",
        "build:court-labels": "node scripts/build-court-labels.ts",
        "build:data-files": "node scripts/build-data-files.ts"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.5",
        "@vitest/coverage-v8": "^5.0.5",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "esbuild": "0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-jsdoc": "^65.4.0",
        "globals": "^17.13.0",
        "node-html-parser": "^9.0.5",
        "pkg-pr-new": "0.0.92",
        "prettier": "^3.9.10",
        "publint": "^0.3.25",
        "tsup": "^9.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^7.3.7",
        "vitepress": "^1.6.4",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "zod": "^4.6.7"
    }
}
