{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/belgica/schema/courts.schema.json",
  "title": "belgica: data/courts.json",
  "type": "array",
  "items": {
    "$ref": "#/definitions/Court"
  },
  "definitions": {
    "Court": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/CourtId",
          "description": "Stable id: the type, then the place in the court's own language (Dutch for Brussels, with `-nl` or `-fr` for the courts split by language); a division or seat adds its place. 'justice-of-the-peace-gent-1', 'enterprise-court-gent-brugge', 'police-court-brussel-fr'"
        },
        "type": {
          "$ref": "#/definitions/CourtType"
        },
        "kind": {
          "type": "string",
          "enum": [
            "court",
            "division",
            "seat"
          ]
        },
        "court": {
          "allOf": [
            {
              "$ref": "#/definitions/CourtId"
            }
          ],
          "description": "For a division or seat: the court it belongs to"
        },
        "name": {
          "$ref": "#/definitions/PartialTranslated",
          "description": "The court's name as it publishes it, in each language it publishes in: 'Vredegerecht Gent 1', 'Tribunal de l'entreprise du Hainaut - division Mons'"
        },
        "label": {
          "allOf": [
            {
              "$ref": "#/definitions/Translated"
            }
          ],
          "description": "For a justice of the peace (not its seats): a label built from its canton's number and name, in each language, as `formatCourtName(court, locale, { style: 'canton' })` gives it: 'Vredegerecht 1e kanton Gent'. Not the court's official name. Generated from the cantons data by the build."
        },
        "judicialArea": {
          "$ref": "#/definitions/JudicialAreaId"
        },
        "arrondissement": {
          "allOf": [
            {
              "$ref": "#/definitions/ArrondissementId"
            }
          ],
          "description": "The arrondissement, for a court whose area is one arrondissement or lies within one"
        },
        "canton": {
          "allOf": [
            {
              "$ref": "#/definitions/CantonId"
            }
          ],
          "description": "For a justice of the peace: the canton it serves"
        },
        "cantons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CantonId"
          },
          "description": "For a court other than a justice of the peace: the cantons it covers, as the annex to the Judicial Code (art. 3–5) and art. 114 of the Code set them. A justice of the peace covers its `canton`. For a division of a court of first instance, enterprise court, labour court or labour court of appeal: the cantons that lie wholly in its area, as the royal decrees under art. 186 of the Code set it; `municipalities` has the rest. A seat, and a division of a police court, has neither."
        },
        "municipalities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MunicipalityId"
          },
          "description": "For a division whose area takes only some municipalities of a canton (one it shares with another division of its court): those municipalities, by REFNIS code. A municipality belongs to the division that has it here, or else to the one that has its canton in `cantons`."
        },
        "ecli": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2,7}$"
          },
          "description": "The court's codes in European Case Law Identifiers (ECLI:BE:<code>:…), one per language it judges in; only codes seen in published decisions"
        },
        "address": {
          "allOf": [
            {
              "$ref": "#/definitions/Address"
            }
          ],
          "description": "Where the registry is; missing when the court publishes no single address"
        },
        "contacts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Contact"
          }
        },
        "openingHours": {
          "type": "string",
          "description": "When the registry is open, in OpenStreetMap `opening_hours` syntax: 'Mo-Fr 08:30-12:30,13:30-16:00'. Only when the published text reads to it without doubt."
        },
        "openingHoursText": {
          "allOf": [
            {
              "$ref": "#/definitions/PartialTranslated"
            }
          ],
          "description": "The opening hours as the court publishes them, per language"
        },
        "website": {
          "$ref": "#/definitions/Website",
          "description": "The court's page, per language"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          },
          "description": "The pages the record was read from"
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "name",
        "judicialArea",
        "contacts",
        "website",
        "sources"
      ],
      "additionalProperties": false,
      "description": "A court, a division of one (afdeling, division, Abteilung), or one of the seats of a justice of the peace that sits in several places."
    },
    "Day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
