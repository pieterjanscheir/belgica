{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pieterjanscheir.github.io/belgica/schema/canton-boundaries.schema.json",
  "title": "belgica: data/canton-boundaries.json",
  "type": "array",
  "items": {
    "$ref": "#/definitions/CantonBoundary"
  },
  "definitions": {
    "CantonBoundary": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/CantonId",
          "description": "The canton's id: a canton has one boundary, which takes its key"
        },
        "canton": {
          "$ref": "#/definitions/CantonId",
          "description": "The canton the boundary belongs to"
        },
        "ngiId": {
          "$ref": "#/definitions/NgiId",
          "description": "The NGI's identifier of the object (its `tgid`), e.g. '{50412818-C0B7-4FEE-9E9B-DFFF0A768922}'"
        },
        "cantonCode": {
          "type": "object",
          "properties": {
            "nl": {
              "type": "string",
              "pattern": "^N?\\d{6}$"
            },
            "fr": {
              "type": "string",
              "pattern": "^F?\\d{6}$"
            }
          },
          "required": [
            "nl",
            "fr"
          ],
          "additionalProperties": false,
          "description": "The canton code in the NGI's data, in Dutch and French: six digits, the same in both ('248112' for Gent 1), with an 'N' or 'F' prefix per language in Brussels-Capital and in Sint-Genesius-Rode ('N238104', 'F238104' for Brussel 1)"
        },
        "geometry": {
          "$ref": "#/definitions/MultiPolygon",
          "description": "The boundary as the NGI publishes it, without simplification: WGS 84, longitude first, coordinates rounded to 7 decimals (about a centimetre). Where a law moved an area the NGI hasn't redrawn yet, the area is moved, and `sources` cites the law."
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "id",
        "canton",
        "ngiId",
        "cantonCode",
        "geometry",
        "sources"
      ],
      "additionalProperties": false,
      "description": "The boundary of a judicial canton, as the National Geographic Institute (NGI) digitised it from the annex to the Judicial Code. The legal text in the canton's `territory` is the law; where the two disagree, the text wins."
    },
    "Day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "description": "A day as YYYY-MM-DD"
    },
    "CantonId": {
      "type": "string",
      "enum": [
        "aalst-1",
        "aalst-2",
        "aarschot",
        "andenne",
        "anderlecht-1",
