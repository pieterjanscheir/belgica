      ],
      "description": "Id of a record in data/cantons.json"
    },
    "NgiId": {
      "type": "string",
      "pattern": "^\\{[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}\\}$",
      "description": "The NGI's identifier of an object (its `tgid`): a GUID in braces, uppercase"
    },
    "MultiPolygon": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "MultiPolygon"
        },
        "coordinates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/PolygonCoordinates"
          }
        }
      },
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "description": "A GeoJSON MultiPolygon geometry (RFC 7946), in WGS 84"
    },
    "PolygonCoordinates": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/Ring"
      },
      "description": "The rings of a GeoJSON polygon: the exterior ring first, counter-clockwise, then its holes, clockwise (RFC 7946)"
    },
    "Ring": {
      "minItems": 4,
      "type": "array",
      "items": {
        "$ref": "#/definitions/Position"
      },
      "description": "A GeoJSON linear ring: closed (the first position repeated last), so at least four positions"
    },
    "Position": {
      "type": "array",
      "items": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "A GeoJSON position: longitude, then latitude, in decimal degrees (WGS 84)"
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/definitions/Url",
          "description": "The exact official page or file the data comes from"
        },
        "retrieved": {
          "$ref": "#/definitions/Day",
          "description": "Day the source was last checked, YYYY-MM-DD"
        }
      },
      "required": [
        "url",
        "retrieved"
      ],
      "additionalProperties": false,
      "description": "Where a record's data was taken from"
    },
    "Url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://",
      "description": "An http(s) URL"
    }
  }
}
