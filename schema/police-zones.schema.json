  "definitions": {
    "PoliceZone": {
      "type": "object",
      "properties": {
        "validFrom": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "First day the record applies, YYYY-MM-DD. No `validFrom`: since before the dataset's coverage starts."
        },
        "validTo": {
          "allOf": [
            {
              "$ref": "#/definitions/Day"
            }
          ],
          "description": "Last day the record applies, YYYY-MM-DD"
        },
        "id": {
          "$ref": "#/definitions/PoliceZoneId",
          "description": "The zone's official number, e.g. '5415' for Gent: the code the federal police uses"
        },
        "name": {
          "$ref": "#/definitions/Translated",
          "description": "The zone's official name per language: the municipalities it covers, in capitals, as the source writes it, e.g. 'AARTSELAAR/EDEGEM/HOVE/KONTICH/LINT'"
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "description": "The short name the zone goes by, in capitals, e.g. 'HESBAYE' or 'REGIO PUYENBROECK'"
        },
        "municipalities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/MunicipalityId"
          },
          "description": "The municipalities it covers, by REFNIS code; every municipality is in exactly one zone"
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceRef"
          }
        }
      },
      "required": [
        "id",
        "name",
        "municipalities",
        "sources"
      ],
      "additionalProperties": false,
      "description": "A police zone (politiezone, zone de police, Polizeizone): the local police of one or more municipalities, as the royal decrees of 28 April 2000 set them, from FOD Financiën's open data"
    },
    "Day": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
